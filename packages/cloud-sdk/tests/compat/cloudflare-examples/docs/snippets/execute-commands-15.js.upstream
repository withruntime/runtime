// Source: https://developers.cloudflare.com/sandbox/sdk/guides/execute-commands/ (code block 15)
// Read 18 October 2026. Copied verbatim; the only change is the package name,
// "@cloudflare/sandbox" -> "withruntime/cloudflare".
const check = await sandbox.exec("which python3");
if (!check.success) {
	console.error("python3 not found");
}
