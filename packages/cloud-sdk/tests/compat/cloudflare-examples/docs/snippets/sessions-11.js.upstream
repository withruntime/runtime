// Source: https://developers.cloudflare.com/sandbox/sdk/api/sessions/ (code block 11)
// Read 18 October 2026. Copied verbatim; the only change is the package name,
// "@cloudflare/sandbox" -> "withruntime/cloudflare".
const sandbox = getSandbox(env.Sandbox, "user-123");

// Set environment variables first
await sandbox.setEnvVars({
	API_KEY: env.OPENAI_API_KEY,
	DATABASE_URL: env.DATABASE_URL,
	NODE_ENV: "production",
	OLD_TOKEN: undefined, // Unsets OLD_TOKEN if previously set
});

// Now commands can access these variables
await sandbox.exec("python script.py");
